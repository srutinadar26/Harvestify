{
  "version": 3,
  "builds": [
    {
      "src": "harvestify-frontend/package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "ml-service/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/predict/(.*)",
      "dest": "/ml-service/app.py"
    },
    {
      "src": "/health",
      "dest": "/ml-service/app.py"
    }
  ]
}
